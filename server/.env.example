# Cryptomus API Credentials
# Get these from https://app.cryptomus.com after creating a merchant
CRYPTOMUS_MERCHANT_ID=your-merchant-uuid-here
CRYPTOMUS_API_KEY=your-payment-api-key-here

# Server Configuration
PORT=3001

# Frontend URL (for return URLs)
FRONTEND_URL=http://localhost:5173

# Backend URL (for webhook callbacks)
BACKEND_URL=http://localhost:3001
